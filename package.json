{
  "name": "introduce-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "자기소개 및 방명록",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/guestbook.integration.test.js",
    "deploy:generate": "node scripts/package-runtime.js",
    "deploy:check": "node scripts/package-runtime.js --check"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
