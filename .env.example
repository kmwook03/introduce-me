PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio-local-only
DB_STARTUP_TIMEOUT_MS=90000
# false by default. Set only to verified router IPs/CIDRs, never true or a hop count.
TRUST_PROXY=false
# Integration tests require a separate database with a name ending in _test.
TEST_DB_NAME=portfolio_test
